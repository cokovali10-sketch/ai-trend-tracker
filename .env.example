# =============================================
# AI Trend Tracker — шаблон конфигурации
# =============================================
# Инструкция:
#   1. Скопируй этот файл в .env
#   2. Заполни GEMINI_API_KEY (рекомендуется) или OPENAI_API_KEY
#   3. Заполни Telegram (если нужна отправка отчётов)
#   4. Остальное можно оставить по умолчанию
# =============================================

# --- Google Gemini (рекомендуется) ---
# Документация: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (альтернатива Gemini) ---
# Документация: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Источник RSS ---
# Любая RSS-лента. По умолчанию — Habr News
# RSS_SOURCE=https://habr.com/ru/rss/news/
# MAX_ARTICLES=15

# --- Выбор AI-провайдера ---
# Доступные значения: "gemini" (по умолчанию) или "openai"
# AI_PROVIDER=gemini

# --- База данных (SQLite) ---
# Путь к файлу БД относительно корня проекта
# DB_PATH=data/trends.db

# --- Telegram Bot ---
# Как получить токен: https://t.me/BotFather
# Как узнать chat_id: https://t.me/getidsbot
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here
