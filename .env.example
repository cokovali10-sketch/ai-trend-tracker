# =============================================
# AI Trend Tracker — шаблон конфигурации
# =============================================
# Инструкция:
#   1. Скопируй этот файл в .env
#   2. Заполни GEMINI_API_KEY (рекомендуется) или OPENAI_API_KEY
#   3. Заполни Telegram (если нужна отправка отчётов)
#   4. Остальное можно оставить по умолчанию
# =============================================

# --- Google Gemini (рекомендуется) ---
# Документация: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI (альтернатива Gemini) ---
# Документация: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Выбор AI-провайдера ---
# Доступные значения: "gemini" (по умолчанию) или "openai"
AI_PROVIDER=gemini

# --- Источники RSS (через запятую) ---
# RSS_SOURCES=https://habr.com/ru/rss/news/,https://www.reddit.com/r/technology/.rss
# MAX_ARTICLES=15

# --- База данных и отчёты ---
# DB_PATH=data/trends.db
# REPORTS_DIR=data/reports
# EXPORT_FORMAT=md    # формат экспорта: md | html | json

# --- Логирование ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/trends.log

# --- Telegram Bot ---
# Как получить токен: https://t.me/BotFather
# Как узнать chat_id: https://t.me/getidsbot
# Можно указать несколько чатов через запятую
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here
# NOTIFY_DISABLED=1   # глобально отключить отправку отчётов в Telegram

# --- Расписание (python main.py run --loop) ---
# RUN_INTERVAL_MIN=60
# BOT_POLL_INTERVAL=2.0   # интервал опроса Telegram в секундах (python main.py bot)
