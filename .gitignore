# =============================================
# AI Trend Tracker — .gitignore
# =============================================

# --- Секреты ---
.env

# --- Виртуальные окружения ---
venv/
.venv/
env/
virtualenv/

# --- Python-кеш ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# --- Локальные данные ---
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite3
data/reports/
logs/
*.sqlite
*.sqlite3

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Сборки и пакеты ---
dist/
build/
*.egg-info/
*.egg

# --- OS-мусор ---
.DS_Store
Thumbs.db
Desktop.ini
