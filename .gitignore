# =============================================
# AI Trend Tracker — .gitignore
# =============================================

# --- Секреты и конфиденциальные данные ---
# Файл .env содержит API-ключи — НИКОГДА не должен попадать в git
.env

# --- Виртуальное окружение Python ---
venv/
.venv/
env/
virtualenv/

# --- Python-кеш и байткод ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Локальная база данных (SQLite) ---
# Не коммитим БД — она создаётся автоматически на каждой машине
data/*.db
data/*.db-journal
data/*.sqlite3
*.sqlite
*.sqlite3

# --- Настройки IDE и редакторов ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Дистрибутивы и сборки ---
*.egg-info/
dist/
build/
*.egg

# --- OS-мусор ---
Thumbs.db
.DS_Store
Desktop.ini
